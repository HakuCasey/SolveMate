{
  "name": "@solvemate/desktop",
  "productName": "SolveMate",
  "version": "0.1.0",
  "description": "SolveMate desktop application",
  "author": "HakuCasey",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "start": "npm run prepare:assets && electron .",
    "package": "npm run prepare:assets && electron-builder --dir",
    "make": "npm run prepare:assets && electron-builder",
    "check": "node --check src/main.mjs && node --check src/runtime.mjs && node --check scripts/prepare-assets.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "^26.18.0"
  },
  "license": "MIT"
}
